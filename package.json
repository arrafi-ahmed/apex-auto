{
  "name": "apex-auto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@panzoom/panzoom": "^4.6.2",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pinia": "^4.1.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
