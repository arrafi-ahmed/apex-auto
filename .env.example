# ==============================================================
# APEX AUTO LOGISTICS & DISPATCH CONFIGURATION (.env)
# ==============================================================

# Master Security PIN or Passphrase (e.g. 4-8 digits like 894201 or passphrase)
VAULT_PIN=secret123

# Emergency Lockout Recovery Token (visit: https://<domain>/?reset_vault_token=<TOKEN>)
ADMIN_RESET_TOKEN=unlock123

# Word in the decoy landing page footer that reveals the security authorization modal
TRIGGER_WORD=guarantee

# Web service port
PORT=3000

# Inactivity Auto-Lock duration in minutes (auto-escapes to decoy if idle)
AUTO_LOCK_MINUTES=5

# Default slideshow rotation speed in seconds
SLIDESHOW_INTERVAL=3

# Car-news archive on the public site (all optional)
# Polled once a day (hours, default 24). Each run adds up to 100 new stories; the archive keeps the newest 200.
# NEWS_REFRESH_HOURS=24
# Direct feeds as "Name|url|link-filters|lang", separated by ";" (a "!" prefix excludes links).
# Defaults: detikOto, CNN Indonesia, Liputan6 Otomotif, ANTARA Otomotif
# NEWS_FEEDS=detikOto|https://oto.detik.com/rss|!/motor/|id;ANTARA Otomotif|https://www.antaranews.com/rss/otomotif.xml||id
# Targeted searches (budget cars, driving tips) via Bing News RSS, an unofficial feed. "off" disables.
# NEWS_BING=off
# NEWS_BING_QUERIES=BYD Atto 1;Honda Brio;tips mengemudi
# Outlets accepted from those searches (name prefixes, comma-separated). Default: Kompas, GridOto, Otomotifnet,
# Bisnis, Oto.com, Otosia, Mobil123, Carmudi, detik, CNN, CNBC, Liputan6, ANTARA, Tempo, Kumparan, Uzone, Viva...
# NEWS_SOURCE_ALLOW=kompas otomotif,gridoto,otomotifnet,detik
# Extra source: free NewsData.io key (https://newsdata.io)
# NEWSDATA_API_KEY=
