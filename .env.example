# ==============================================================
# APEX AUTO LOGISTICS & DISPATCH CONFIGURATION (.env)
# ==============================================================

# Master Security PIN or Passphrase (e.g. 4-8 digits like 894201 or passphrase)
VAULT_PIN=secret123

# Emergency Lockout Recovery Token (visit: https://<domain>/?reset_vault_token=<TOKEN>)
ADMIN_RESET_TOKEN=unlock123

# Word in the decoy landing page footer that reveals the security authorization modal
TRIGGER_WORD=guarantee

# Web service port
PORT=3000

# Inactivity Auto-Lock duration in minutes (auto-escapes to decoy if idle)
AUTO_LOCK_MINUTES=5

# Default slideshow rotation speed in seconds
SLIDESHOW_INTERVAL=3
